# Copy this file to .env for local development (never commit the real .env).
# On Render/Railway/Heroku/Vercel, set these as platform environment variables
# instead - do not upload a .env file to those platforms.

# Random long random string. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Your MongoDB Atlas connection string (Atlas dashboard -> Connect -> Drivers).
# Local example if you're running MongoDB in Docker/locally instead of Atlas:
#   MONGO_URI=mongodb://localhost:27017/DevHost
MONGO_URI=
